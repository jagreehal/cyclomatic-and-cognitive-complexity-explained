{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/complexity-check.sh edited",
            "timeout": 30,
            "statusMessage": "Checking complexity of the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/complexity-check.sh stop",
            "timeout": 60,
            "statusMessage": "Complexity ratchet on changed files"
          }
        ]
      }
    ]
  }
}
